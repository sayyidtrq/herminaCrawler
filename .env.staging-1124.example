# Template env untuk crawler staging 1.124.
# Salin ke .env.staging-1124 (mode 600), isi semua nilai bertanda ISI/change-me.
# Jangan commit file hasilnya. Bila memakai scripts/bootstrap-staging-1124.sh,
# bagian wajib di bawah ditulis otomatis dan secret dibangkitkan acak.
#
# Bangkitkan secret:  openssl rand -hex 32

# ============================ WAJIB ============================

APP_ENV=staging
APP_NAME=VoC Crawler Staging 1.124
LOG_LEVEL=INFO

# Driver harus psycopg2 (satu-satunya yang terpasang di image).
# Role dan database dibuat lebih dulu: voc_staging_1124 / voc_staging_1124.
DATABASE_URL=postgresql+psycopg2://voc_staging_1124:ISI-password-db@postgresql:5432/voc_staging_1124

# Tiga secret di bawah harus unik per environment. JWT_SECRET_KEY dan
# SERVICE_TOKEN_PEPPER yang masih berawalan "change-me" membuat app menolak start.
JWT_SECRET_KEY=change-me-ISI-openssl-rand-hex-32
SERVICE_TOKEN_PEPPER=change-me-ISI-openssl-rand-hex-32
# Menandatangani cursor paging. Jangan dibagikan ke OneBox.
INTEGRATION_CURSOR_SECRET=change-me-ISI-openssl-rand-hex-32

# Sumber worklist: akun service OneBox staging (login ke SiteId di bawah).
ONEBOX_BASE_URL=https://staging.onebox.co.id/1_124_0
ONEBOX_SVC_EMAIL=ISI-email-akun-service
ONEBOX_SVC_PASSWORD=ISI-password-akun-service
# Verifikasi: nilai ini dibawa dari staging 1.123.
ONEBOX_SITE_ID=169
# Id company di crawler (dibuat deploy-staging-1124.sh --initial; harus 1).
ONEBOX_COMPANY_ID=1
ONEBOX_WORKLIST_PATH=/api/VocWorklist

# Sumber review: Apify. Beberapa token dipisah koma, dicoba berurutan.
REVIEW_SOURCE_MODE=apify
APIFY_API_TOKENS=ISI-token-apify-1,ISI-token-apify-2

# Port API di host. Bentrok dengan stack 1.123 (juga 8001) bila keduanya hidup.
STAGING_API_PORT=8001

# ========================== ANALISIS AI ==========================
# Provider bawaan untuk review yang di-crawl. OneBox 1.124 bisa memilih
# absa/openai/jev per koneksi; yang tidak punya kredensial dilaporkan "tidak
# tersedia" ke OneBox, bukan error.
ANALYSIS_PROVIDER=absa
AUTO_ANALYZE_ON_CRAWL=true

# ABSA: berjalan di host yang sama (port 9090). host.docker.internal dipetakan
# oleh docker-compose.staging-1124.yml.
ABSA_BASE_URL=http://host.docker.internal:9090/api
ABSA_ENGINE_VERSION=v14
ABSA_PROFILE=maps_high_recall
ABSA_CONFIDENCE_THRESHOLD=0.1
ABSA_TIMEOUT_SECONDS=300

# OpenAI: kosongkan kunci bila tidak dipakai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# TypeSafe (Jev): kosongkan kunci bila tidak dipakai.
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_MODEL=jev-latest
TYPESAFE_TIMEOUT_SECONDS=300

# ================== OPSIONAL (nilai di bawah = default kode) ==================
# Hanya ubah bila ada alasan; boleh dihapus.

# Origin browser untuk CORS (hanya origin, tanpa path).
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://localhost.onebox.co.id

# REDIS_URL di-set oleh docker-compose.staging-1124.yml (redis://redis:6379/0).
APIFY_ACTOR_ID=web_wanderer/google-reviews-scraper
APIFY_RUN_TIMEOUT_SECONDS=300
APIFY_POLL_INTERVAL_SECONDS=5
APIFY_ACCOUNT_EXHAUSTED_TTL_SECONDS=1800
APIFY_BACKFILL_DEADLINE_SECONDS=7200

# Batas ulasan per penarikan; OneBox 1.124 memakai default 5000, maksimum 100000.
CRAWL_DEFAULT_REVIEW_LIMIT=5000
CRAWL_MAX_TARGET_REVIEWS=100000
CRAWL_COMPLETENESS_TOLERANCE=0.98
CRAWL_WATERMARK_MARGIN_DAYS=1
CRAWL_SAFETY_SWEEP_DAYS=30
CRAWL_ASYNC_SOURCE_RUNS=true
CRAWL_SOURCE_POLL_SECONDS=30

# Worker crawl.
CRAWL_WORKER_LEASE_SECONDS=900
CRAWL_WORKER_MAX_ATTEMPTS=3
CRAWL_WORKER_POLL_SECONDS=5
CRAWL_WORKER_RETRY_BASE_SECONDS=60

# Klien OneBox.
ONEBOX_TIMEOUT_SECONDS=30
ONEBOX_MAX_RETRY=3
ONEBOX_WORKLIST_CACHE_STALE_AFTER_SECONDS=86400

# Pipeline analisis.
ANALYSIS_BATCH_SIZE=20
ANALYSIS_LLM_MAX_RETRIES=2
ANALYSIS_LLM_RETRY_BACKOFF_SECONDS=1.0
ANALYSIS_CIRCUIT_BREAKER_THRESHOLD=5
ANALYSIS_LLM_CONCURRENCY=4

# Jangan true di staging: payload mentah berisi konten pengguna.
SHOW_RAW_PAYLOAD=false
