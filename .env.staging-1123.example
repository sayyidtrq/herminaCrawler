# Copy to .env.staging-1123 with scripts/bootstrap-staging-1123.sh.
# Never commit the generated file.
APP_ENV=staging
APP_NAME=VoC Crawler Staging 1.123
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://voc_staging_1123:change-me@postgresql:5432/voc_staging_1123
INTEGRATION_CURSOR_SECRET=change-me
JWT_SECRET_KEY=change-me
SERVICE_TOKEN_PEPPER=change-me

# Apify menggantikan Selenium sebagai sumber review. Token dipisah koma;
# dicoba berurutan. REDIS_URL di-set oleh docker-compose.staging-1123.yml.
REVIEW_SOURCE_MODE=apify
APIFY_API_TOKENS=change-me

# ABSA default. OpenAI/Jev hanya aktif bila kuncinya diisi:
#   OPENAI_API_KEY=...  TYPESAFE_API_KEY=...
ANALYSIS_PROVIDER=absa

ONEBOX_BASE_URL=https://staging.onebox.co.id/1_123_0
ONEBOX_SVC_EMAIL=change-me
ONEBOX_SVC_PASSWORD=change-me
ONEBOX_SITE_ID=169
ONEBOX_COMPANY_ID=1
ONEBOX_WORKLIST_PATH=/api/VocWorklist

STAGING_API_PORT=8001
